            ],
            "url": { "raw": "{{base_url}}/api/book-categories", "host": ["{{base_url}}"], "path": ["api", "book-categories"] },
            "body": { "mode": "raw", "raw": "{\n  \"book_id\": 1,\n  \"category_id\": 1\n}" }
          }
        },
        {
          "name": "Show Book Category",
          "request": {
