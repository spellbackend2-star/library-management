            ],
            "url": { "raw": "{{base_url}}/api/book-categories/1", "host": ["{{base_url}}"], "path": ["api", "book-categories", "1"] },
            "body": { "mode": "raw", "raw": "{\n  \"category_id\": 2\n}" }
          }
        },
        {
          "name": "Delete Book Category",
          "request": {
